# Sulduz Cloud — server environment
# Copy to server/.env and adjust. install.sh writes this file for you.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Database + backups (keep them off the install directory)
DATA_DIR=/var/lib/sulduzcloud
BACKUP_DIR=/var/lib/sulduzcloud/backups

# Public URL of the panel (https://... enables secure cookies)
PUBLIC_URL=https://panel.example.com

# Reporting/backup timezone
PANEL_TZ=Asia/Tehran

# Optional: 3x-ui address/token can also be set in the admin UI.
# XUI_URL=https://127.0.0.1:2053
# XUI_TOKEN_FILE=/var/lib/sulduzcloud/secrets/xui-token
