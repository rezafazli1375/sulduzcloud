#!/usr/bin/env bash
# Sulduz Cloud in-panel updater (root helper).
#
# Called by the panel through `sudo -n /usr/local/bin/sulduzcloud-update vX.Y.Z`
# (installed by install.sh together with a NOPASSWD sudoers entry). It downloads
# the requested tag from the public GitHub mirror, replaces only the application
# code, rebuilds the web bundle and restarts the panel service.
#
# It never touches the database, server/.env, secrets, node_modules or web/dist
# caches beyond rebuilding dist, and it never restarts x-ui.
set -uo pipefail

TAG="${1:-}"
REPO="${SULDUZ_UPDATE_REPO:-rezafazli1375/sulduzcloud}"
APP="${SULDUZ_APP_DIR:-/opt/sulduzcloud}"
DATA="${SULDUZ_DATA_DIR:-/var/lib/sulduzcloud}"
LOG="${UPDATE_LOG:-/var/log/sulduzcloud-update.log}"
MARKER="$DATA/update-running"
LAST="$DATA/update-last.json"
SERVICE="${SULDUZ_SERVICE:-sulduzcloud}"
PORT="${SULDUZ_PORT:-3100}"

if [[ ! "$TAG" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "invalid version tag: $TAG" >&2
  exit 2
fi
TAG="v${TAG#v}"

mkdir -p "$DATA"
touch "$LOG" 2>/dev/null && chmod 644 "$LOG" 2>/dev/null

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"; }

exec 9>/run/sulduzcloud-update.lock
if ! flock -n 9; then
  log "another update is already running"
  exit 3
fi

: > "$MARKER" 2>/dev/null && chmod 644 "$MARKER" 2>/dev/null

TMP="$(mktemp -d /tmp/sulduz-update.XXXXXX)"
EXIT_OK=0
EXIT_MSG="update failed"

on_exit() {
  local code=$?
  [ -n "$TMP" ] && rm -rf "$TMP"
  rm -f "$MARKER"
  local ok=false
  if [ "$code" -eq 0 ]; then ok=true; else EXIT_MSG="${EXIT_MSG:-update failed}"; fi
  printf '{"tag":"%s","ok":%s,"finishedAt":%s,"message":"%s"}\n' \
    "$TAG" "$ok" "$(date +%s)000" "$EXIT_MSG" > "$LAST.tmp" 2>/dev/null \
    && mv -f "$LAST.tmp" "$LAST" 2>/dev/null
  chmod 644 "$LAST" 2>/dev/null
  exit "$code"
}
trap on_exit EXIT

log "== update to $TAG started =="

# ---------------------------------------------------------------- backup code
BK="/root/sulduzcloud-code-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BK"
cp -a "$APP/server/src" "$APP/web/src" "$APP/menu.sh" "$BK"/ 2>/dev/null
cp -a "$APP/server/.env" "$BK/server.env" 2>/dev/null
cp -a "$APP/scripts" "$BK/scripts" 2>/dev/null
log "code backup: $BK"

# ------------------------------------------------------------------- download
URL="https://github.com/$REPO/archive/refs/tags/$TAG.tar.gz"
log "downloading $URL"
if ! curl -fsSL --retry 3 --retry-delay 2 --max-time 180 -o "$TMP/src.tgz" "$URL"; then
  EXIT_MSG="download failed"; log "$EXIT_MSG"; exit 4
fi
tar -xzf "$TMP/src.tgz" -C "$TMP" || { EXIT_MSG="archive extraction failed"; log "$EXIT_MSG"; exit 4; }
SRC="$(find "$TMP" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
if [ -z "$SRC" ] || [ ! -f "$SRC/server/src/index.js" ]; then
  EXIT_MSG="downloaded archive is incomplete"; log "$EXIT_MSG"; exit 4
fi

SERVER_DEPS_CHANGED=0
WEB_DEPS_CHANGED=0
if [ -f "$SRC/server/package-lock.json" ] && [ -f "$APP/server/package-lock.json" ]; then
  cmp -s "$SRC/server/package-lock.json" "$APP/server/package-lock.json" || SERVER_DEPS_CHANGED=1
fi
if [ -f "$SRC/web/package-lock.json" ] && [ -f "$APP/web/package-lock.json" ]; then
  cmp -s "$SRC/web/package-lock.json" "$APP/web/package-lock.json" || WEB_DEPS_CHANGED=1
fi

# --------------------------------------------------------------- install code
log "installing application files"
rsync -a --delete "$SRC/server/src/" "$APP/server/src/" || { EXIT_MSG="server copy failed"; log "$EXIT_MSG"; exit 5; }
[ -d "$SRC/server/scripts" ] && rsync -a --delete "$SRC/server/scripts/" "$APP/server/scripts/"
[ -d "$SRC/server/test" ] && rsync -a --delete "$SRC/server/test/" "$APP/server/test/"
cp "$SRC/server/package.json" "$APP/server/" 2>/dev/null
cp "$SRC/server/package-lock.json" "$APP/server/" 2>/dev/null
rsync -a --delete "$SRC/web/src/" "$APP/web/src/" || { EXIT_MSG="web copy failed"; log "$EXIT_MSG"; exit 5; }
[ -d "$SRC/web/public" ] && rsync -a --delete "$SRC/web/public/" "$APP/web/public/"
for f in index.html package.json package-lock.json postcss.config.js tailwind.config.js vite.config.js; do
  [ -f "$SRC/web/$f" ] && cp "$SRC/web/$f" "$APP/web/"
done
[ -f "$SRC/menu.sh" ] && cp "$SRC/menu.sh" "$APP/menu.sh"
if [ -d "$SRC/scripts" ]; then
  mkdir -p "$APP/scripts"
  rsync -a "$SRC/scripts/" "$APP/scripts/"
  if [ -f "$APP/scripts/sulduzcloud-update" ]; then
    install -m 755 "$APP/scripts/sulduzcloud-update" /usr/local/bin/sulduzcloud-update
  fi
fi
if [ -f "$APP/menu.sh" ]; then
  install -m 755 "$APP/menu.sh" /usr/local/bin/sulduzcloud
fi

chown -R root:root "$APP/server/src" "$APP/web/src" 2>/dev/null

# ---------------------------------------------------------------- dependencies
if [ "$SERVER_DEPS_CHANGED" = "1" ]; then
  log "server dependencies changed; running npm ci"
  ( cd "$APP/server" && npm ci --omit=dev --no-audit --no-fund ) >>"$LOG" 2>&1 \
    || { EXIT_MSG="server dependency install failed"; log "$EXIT_MSG"; exit 6; }
fi
if [ "$WEB_DEPS_CHANGED" = "1" ]; then
  log "web dependencies changed; running npm ci"
  ( cd "$APP/web" && npm ci --no-audit --no-fund ) >>"$LOG" 2>&1 \
    || { EXIT_MSG="web dependency install failed"; log "$EXIT_MSG"; exit 6; }
fi

# ------------------------------------------------------------------ build web
log "building the web bundle"
if ! ( cd "$APP/web" && npx vite build ) >>"$LOG" 2>&1; then
  EXIT_MSG="web build failed"; log "$EXIT_MSG"; exit 7
fi

# -------------------------------------------------------------------- restart
log "restarting $SERVICE"
systemctl restart "$SERVICE"
for _ in $(seq 1 30); do
  if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
    EXIT_MSG="updated to $TAG"
    log "$EXIT_MSG"
    exit 0
  fi
  sleep 1
done

EXIT_MSG="service did not come back after restart"
log "$EXIT_MSG"
systemctl status "$SERVICE" --no-pager -n 20 >>"$LOG" 2>&1
exit 8
